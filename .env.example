# Variables de Robot Expedition. Ninguna es secreta ni obligatoria: sin ellas todo funciona en local.
# Copiar a .env (ignorado por git) solo si se quiere cambiar algo.

# Servidor de MLflow compartido. Sin esta variable se usa sqlite:///mlflow.db en la raíz del proyecto.
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Dirección de la API de simulación que usa la web estática para evaluar en vivo.
# En Vercel es /sim (misma URL que la web). Vacía: la web solo muestra replays grabados.
API_REMOTA=/sim

# Servidor local de `expedicion servir`.
PORT=8765
HOST=127.0.0.1

# Origen permitido por CORS en la API (solo lectura).
CORS_ORIGEN=*

# Medición en episodios nuevos con scripts/medir40.py
# TAREAS="exp-108 exp-107a"
# CONTROL=exp-108
# BASE=5000   # 5000 para elegir, 3000 para confirmar
