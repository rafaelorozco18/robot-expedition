<!-- Bípedo v1: torso y dos piernas, 10 articulaciones con servo de posición (kp, kv) y torque limitado.
     Unidades SI. z arriba, x adelante, y izquierda. La gravedad la fija el ambiente en cada episodio. -->
<mujoco model="bipedo-v1">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.004" integrator="implicitfast"/>

  <default>
    <joint type="hinge" damping="1.5" armature="0.03" limited="true"/>
    <geom friction="0.9 0.05 0.01" condim="3"/>
        <default class="hueso"><geom type="capsule" size="0.04" rgba="0.94 0.93 0.9 1"/></default>
    <default class="pie"><geom type="box" size="0.11 0.05 0.02" pos="0.03 0 -0.04" mass="0.5" rgba="0.2 0.24 0.3 1"/></default>
  </default>

  <worldbody>
    <geom name="piso" type="plane" size="30 30 0.1" rgba="0.5 0.5 0.5 1"/>

    <body name="torso" pos="0 0 0.9">
      <freejoint name="raiz"/>
      <geom name="torso" type="box" size="0.08 0.13 0.19" pos="0 0 0.22" mass="8" rgba="0.94 0.93 0.9 1"/>
      <geom name="franja" type="box" size="0.082 0.132 0.025" pos="0 0 0.24" mass="0.01" rgba="1 0.48 0.1 1" contype="0" conaffinity="0"/>
      <geom name="cabeza" type="sphere" size="0.08" pos="0 0 0.5" mass="1" rgba="0.11 0.15 0.19 1"/>
      <geom name="ojo" type="sphere" size="0.022" pos="0.07 0 0.51" mass="0.01" rgba="0.25 0.82 0.88 1" contype="0" conaffinity="0"/>

      <body name="muslo_i" pos="0 0.09 0">
        <joint name="cadera_roll_i" axis="1 0 0" range="-0.4 0.5"/>
        <joint name="cadera_pitch_i" axis="0 1 0" range="-1.5 0.6"/>
        <geom name="muslo_i" class="hueso" fromto="0 0 0 0 0 -0.4" mass="2.5"/>
        <body name="pantorrilla_i" pos="0 0 -0.4">
          <joint name="rodilla_i" axis="0 1 0" range="0 2.3"/>
          <geom name="pantorrilla_i" class="hueso" fromto="0 0 0 0 0 -0.4" size="0.035" mass="1.5"/>
          <body name="pie_i" pos="0 0 -0.4">
            <joint name="tobillo_pitch_i" axis="0 1 0" range="-0.7 0.7"/>
            <joint name="tobillo_roll_i" axis="1 0 0" range="-0.4 0.4"/>
            <geom name="pie_i" class="pie"/>
          </body>
        </body>
      </body>

      <body name="muslo_d" pos="0 -0.09 0">
        <joint name="cadera_roll_d" axis="1 0 0" range="-0.5 0.4"/>
        <joint name="cadera_pitch_d" axis="0 1 0" range="-1.5 0.6"/>
        <geom name="muslo_d" class="hueso" fromto="0 0 0 0 0 -0.4" mass="2.5"/>
        <body name="pantorrilla_d" pos="0 0 -0.4">
          <joint name="rodilla_d" axis="0 1 0" range="0 2.3"/>
          <geom name="pantorrilla_d" class="hueso" fromto="0 0 0 0 0 -0.4" size="0.035" mass="1.5"/>
          <body name="pie_d" pos="0 0 -0.4">
            <joint name="tobillo_pitch_d" axis="0 1 0" range="-0.7 0.7"/>
            <joint name="tobillo_roll_d" axis="1 0 0" range="-0.4 0.4"/>
            <geom name="pie_d" class="pie"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="cadera_roll_i" joint="cadera_roll_i" kp="80" kv="8" forcerange="-80 80"/>
    <position name="cadera_pitch_i" joint="cadera_pitch_i" kp="100" kv="10" forcerange="-100 100"/>
    <position name="rodilla_i" joint="rodilla_i" kp="120" kv="12" forcerange="-120 120"/>
    <position name="tobillo_pitch_i" joint="tobillo_pitch_i" kp="50" kv="5" forcerange="-50 50"/>
    <position name="tobillo_roll_i" joint="tobillo_roll_i" kp="30" kv="3" forcerange="-30 30"/>
    <position name="cadera_roll_d" joint="cadera_roll_d" kp="80" kv="8" forcerange="-80 80"/>
    <position name="cadera_pitch_d" joint="cadera_pitch_d" kp="100" kv="10" forcerange="-100 100"/>
    <position name="rodilla_d" joint="rodilla_d" kp="120" kv="12" forcerange="-120 120"/>
    <position name="tobillo_pitch_d" joint="tobillo_pitch_d" kp="50" kv="5" forcerange="-50 50"/>
    <position name="tobillo_roll_d" joint="tobillo_roll_d" kp="30" kv="3" forcerange="-30 30"/>
  </actuator>
</mujoco>
